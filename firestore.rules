rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Contact form submissions — write-only from client
    match /contacts/{docId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'message', 'createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.email is string;
      allow read, update, delete: if false;
    }

    // Consultation bookings — write-only from client
    match /consultations/{docId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.email is string;
      allow read, update, delete: if false;
    }

    // Quick contact submissions — write-only from client
    match /quick_contacts/{docId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.email is string;
      allow read, update, delete: if false;
    }

    // Feedback submissions — write-only from client
    match /feedback/{docId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'rating', 'createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.email is string
                    && request.resource.data.rating is int;
      allow read, update, delete: if false;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
